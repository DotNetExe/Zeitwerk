@inherits LayoutComponentBase

<MudThemeProvider Theme="ZeitwerkTheme.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" />
<MudSnackbarProvider />
<Shortcuts />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="zw-appbar">
        <a href="" class="zw-brand mr-6" aria-label="Zeitwerk – zur Tagesansicht">
            <img src="@Assets["logo.svg"]" alt="" class="zw-brand-mark" />
            <span class="zw-brand-word">Zeit<span>werk</span></span>
        </a>
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Today" Class="zw-navlink">Tag</MudNavLink>
        <MudNavLink Href="woche" Icon="@Icons.Material.Filled.ViewWeek" Class="zw-navlink">Woche</MudNavLink>
        <MudNavLink Href="kalender" Icon="@Icons.Material.Filled.CalendarMonth" Class="zw-navlink">Kalender</MudNavLink>
        <MudNavLink Href="auswertung" Icon="@Icons.Material.Filled.BarChart" Class="zw-navlink">Auswertung</MudNavLink>
        <MudNavLink Href="stammdaten" Icon="@Icons.Material.Filled.FolderOpen" Class="zw-navlink">Stammdaten</MudNavLink>
        <MudNavLink Href="export" Icon="@Icons.Material.Filled.FileDownload" Class="zw-navlink">Export</MudNavLink>
        <MudNavLink Href="einstellungen" Icon="@Icons.Material.Filled.Settings" Class="zw-navlink">Einstellungen</MudNavLink>
    </MudAppBar>
    <MudMainContent>
        <div class="zw-shell">
            <aside class="zw-timerbar-host">
                <TimerBar />
            </aside>
            <main class="zw-content">
                @Body
            </main>
        </div>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>
