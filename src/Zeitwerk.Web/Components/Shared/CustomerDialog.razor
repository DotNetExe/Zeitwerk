@inject MasterDataService MasterData

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(Customer is null ? "Kunde anlegen" : "Kunde bearbeiten")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" OnKeyDown="@(e => e.Key == "Enter" ? Save() : Task.CompletedTask)" />
            <MudTextField @bind-Value="_ticketUrl" Label="Ticket-URL (optional)" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="https://jira.example.com/browse/{ticket}"
                          HelperText="Ticketnummern in Tätigkeiten werden verlinkt; {ticket} wird ersetzt." />
            <MudTextField @bind-Value="_ticketPattern" Label="Ticket-Muster (regulärer Ausdruck)" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="@TicketLinks.DefaultPattern" HelperText="@($"Leer = {TicketLinks.DefaultPattern}")" />
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Speichern</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Customer? Customer { get; set; }

    private string _name = "";
    private string? _ticketUrl;
    private string? _ticketPattern;
    private string? _error;

    protected override void OnInitialized()
    {
        _name = Customer?.Name ?? "";
        _ticketUrl = Customer?.TicketUrlTemplate;
        _ticketPattern = Customer?.TicketPattern;
    }

    private async Task Save()
    {
        _error = await MasterData.SaveCustomerAsync(Customer?.Id ?? 0, _name, _ticketUrl, _ticketPattern);
        if (_error is null)
            MudDialog.Close(DialogResult.Ok(true));
    }
}
