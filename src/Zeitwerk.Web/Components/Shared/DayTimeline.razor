@* Horizontaler Zeitstrahl eines Tages; Blöcke in Projektfarbe, Klick öffnet den Eintrag.
   Lücken zwischen Einträgen sind schraffiert; Klick legt einen Eintrag für die Lücke an. *@
@inject Clock Clock

<div class="zw-timeline@(ShowHourLabels ? "" : " zw-timeline-compact")">
    <div class="zw-timeline-track">
        @for (var h = _fromHour; h <= _toHour; h++)
        {
            <div class="zw-timeline-hour" style="left:@Pct(h * 60)">
                @if (ShowHourLabels)
                {
                    <span>@h.ToString("00")</span>
                }
            </div>
        }
        @foreach (var entry in Entries)
        {
            var (start, end) = Clip(Clock, Date, entry, Now);
            if (end <= start)
                continue;
            var onHold = entry.IsOnHold(Now);
            var running = entry.IsOpen && !onHold;
            var css = "zw-block" + (onHold ? " zw-block-hold" : "") + (running ? " zw-block-running" : "");
            <div class="@css"
                 style="left:@Pct(start);width:@Pct(end - start, offset: false);--c:@entry.Project.Color"
                 title="@Tooltip(entry)"
                 @onclick="() => OnEntryClick.InvokeAsync(entry)">
                <span>@entry.Project.Name@if (entry.Activity is not null){<text> · </text><ActivityText Activity="@entry.Activity" Project="entry.Project" />}</span>
            </div>
        }
        @foreach (var gap in Gaps)
        {
            var start = Minutes(gap.Start);
            <div class="zw-gap"
                 style="left:@Pct(start);width:@Pct(Minutes(gap.End) - start, offset: false)"
                 title="@GapTooltip(gap)"
                 @onclick="() => OnGapClick.InvokeAsync(gap)"></div>
        }
        @if (Clock.LocalDate(Now) == Date)
        {
            var minute = MinuteOfDay(Clock, Now);
            if (minute >= _fromHour * 60 && minute <= _toHour * 60)
            {
                <div class="zw-timeline-now" style="left:@Pct(minute)" title="Jetzt"></div>
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DateOnly Date { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<TimeEntry> Entries { get; set; } = [];
    [Parameter, EditorRequired] public DateTimeOffset Now { get; set; }
    [Parameter] public EventCallback<TimeEntry> OnEntryClick { get; set; }
    [Parameter] public IReadOnlyList<Gap> Gaps { get; set; } = [];
    [Parameter] public EventCallback<Gap> OnGapClick { get; set; }
    /// <summary>Fester Ausschnitt, z. B. gemeinsam für mehrere Zeitleisten; ohne Angabe Auto-Zoom.</summary>
    [Parameter] public HourRange? Range { get; set; }
    [Parameter] public bool ShowHourLabels { get; set; } = true;

    private int _fromHour, _toHour;

    protected override void OnParametersSet() =>
        (_fromHour, _toHour) = Range ?? AutoZoom(Clock, Date, Entries, Now);

    /// <summary>Auto-Zoom: Standard 07–19 Uhr, erweitert auf alle Einträge des Tages und die Jetzt-Linie (volle Stunden).</summary>
    public static HourRange AutoZoom(Clock clock, DateOnly date, IEnumerable<TimeEntry> entries, DateTimeOffset now)
    {
        var range = HourRange.Default;
        foreach (var entry in entries)
        {
            var (start, end) = Clip(clock, date, entry, now);
            if (end > start)
                range = range.Include(start, end);
        }
        if (clock.LocalDate(now) == date)
        {
            var minute = MinuteOfDay(clock, now);
            range = range.Include(minute, minute);
        }
        return range;
    }

    /// <summary>Beginn und Ende des Eintrags in Minuten seit Tagesbeginn, auf den Tag begrenzt.</summary>
    private static (int Start, int End) Clip(Clock clock, DateOnly date, TimeEntry entry, DateTimeOffset now)
    {
        var dayStart = clock.StartOfDay(date);
        var dayEnd = clock.StartOfDay(date.AddDays(1));
        // Offene Einträge reichen bis jetzt (mindestens einen Slot, damit on hold sichtbar ist).
        var end = entry.End ?? Max(now, entry.Start + TimeGrid.Slot);
        var start = Max(entry.Start, dayStart);
        end = end < dayEnd ? end : dayEnd;
        return ((int)(start - dayStart).TotalMinutes, (int)(end - dayStart).TotalMinutes);
    }

    private int Minutes(DateTimeOffset t) => (int)(t - Clock.StartOfDay(Date)).TotalMinutes;

    private static int MinuteOfDay(Clock clock, DateTimeOffset t) => (int)(t - clock.StartOfDay(clock.LocalDate(t))).TotalMinutes;

    private static DateTimeOffset Max(DateTimeOffset a, DateTimeOffset b) => a > b ? a : b;

    private string Pct(int minutes, bool offset = true)
    {
        var span = (_toHour - _fromHour) * 60.0;
        var value = offset ? minutes - _fromHour * 60 : minutes;
        return (value / span * 100).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }

    private string Tooltip(TimeEntry e)
    {
        var start = Clock.ToLocal(e.Start).ToString("HH:mm");
        var end = e.End is { } t ? Clock.ToLocal(t).ToString("HH:mm") : e.IsOnHold(Now) ? "on hold" : "läuft";
        var activity = e.Activity is null ? "" : $"\n{e.Activity}";
        return $"{e.Project.DisplayName}{activity}\n{start} – {end} ({Format.Duration(e.Duration(Now))})";
    }

    private string GapTooltip(Gap gap) =>
        $"Lücke (Pause?)\n{Clock.ToLocal(gap.Start):HH:mm} – {Clock.ToLocal(gap.End):HH:mm} ({Format.Duration(gap.Duration)})\nKlick: Eintrag für die Lücke anlegen";
}
