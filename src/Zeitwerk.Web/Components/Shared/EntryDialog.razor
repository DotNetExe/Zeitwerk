@* Zeiteintrag anlegen oder bearbeiten. *@
@inject EntryService Entries
@inject MasterDataService MasterData
@inject Clock Clock
@inject IDialogService Dialogs

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(Entry is null ? "Eintrag hinzufügen" : "Eintrag bearbeiten")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="zw-dialog-body">
            <ProjectPicker Projects="_projects" @bind-Value="_project" Required="true" />
            <ActivityField ProjectId="_project?.Id" @bind-Value="_activity" />
            <MudDatePicker Label="Datum" @bind-Date="_date" Variant="Variant.Outlined" Margin="Margin.Dense"
                           DateFormat="dd.MM.yyyy" ShowWeekNumbers="true" />
            <MudStack Row="true" Spacing="3">
                <MudTimePicker Label="Beginn" @bind-Time="_start" MinuteSelectionStep="5" AmPm="false"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true" />
                <MudTimePicker Label="Ende" @bind-Time="_end" MinuteSelectionStep="5" AmPm="false"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true" Disabled="_stillOpen"
                               HelperText="00:00 = Mitternacht" />
            </MudStack>
            @if (Entry?.IsOpen == true)
            {
                <MudSwitch T="bool" @bind-Value="_stillOpen" Color="Color.Primary" Label="Läuft noch (offener Eintrag)" />
            }
            @foreach (var partner in _mergePartners)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Icon="@Icons.Material.Filled.MergeType">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <span>
                            Grenzt direkt an einen Eintrag mit gleicher Arbeit
                            (@Clock.ToLocal(partner.Start).ToString("HH:mm") – @Clock.ToLocal(partner.End!.Value).ToString("HH:mm")).
                        </span>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" OnClick="() => Merge(partner)">Zusammenführen</MudButton>
                    </MudStack>
                </MudAlert>
            }
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (Entry is not null)
        {
            <MudButton Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="Delete">Löschen</MudButton>
        }
        @if (Entry is not null && SplitMergeRules.SplitPoints(Entry).Count > 0)
        {
            <MudButton StartIcon="@Icons.Material.Filled.ContentCut" OnClick="Split">Teilen</MudButton>
        }
        <MudSpacer />
        <MudButton OnClick="() => MudDialog.Cancel()">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_project is null">Speichern</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Zu bearbeitender Eintrag; <c>null</c> legt einen neuen an.</summary>
    [Parameter] public TimeEntry? Entry { get; set; }

    /// <summary>Vorbelegtes Datum für neue Einträge.</summary>
    [Parameter] public DateOnly Date { get; set; }

    /// <summary>Vorbelegter Beginn und vorbelegtes Ende für neue Einträge, z. B. aus einer Lücke.</summary>
    [Parameter] public DateTimeOffset? Start { get; set; }
    [Parameter] public DateTimeOffset? End { get; set; }

    private List<Project> _projects = [];
    private Project? _project;
    private string? _activity;
    private DateTime? _date;
    private TimeSpan? _start, _end;
    private bool _stillOpen;
    private string? _error;
    private List<TimeEntry> _mergePartners = [];

    protected override async Task OnInitializedAsync()
    {
        _projects = await MasterData.GetActiveProjectsAsync();
        if (Entry is null)
        {
            _date = Date.ToDateTime(TimeOnly.MinValue);
            _start = Start is { } s ? Clock.ToLocal(s).TimeOfDay : null;
            _end = End is { } e ? Clock.ToLocal(e).TimeOfDay : null;
            return;
        }

        // Archivierte Projekte bleiben für bestehende Einträge wählbar.
        if (_projects.All(p => p.Id != Entry.ProjectId))
            _projects.Insert(0, Entry.Project);
        _project = _projects.First(p => p.Id == Entry.ProjectId);
        _activity = Entry.Activity;
        var start = Clock.ToLocal(Entry.Start);
        _date = start.Date;
        _start = start.TimeOfDay;
        _end = Entry.End is { } end ? Clock.ToLocal(end).TimeOfDay : null;
        _stillOpen = Entry.IsOpen;
        _mergePartners = await Entries.GetMergePartnersAsync(Entry);
    }

    private async Task Save()
    {
        _error = null;
        if (_project is null || _date is null || _start is null || (!_stillOpen && _end is null))
        {
            _error = "Bitte Projekt, Datum, Beginn und Ende angeben.";
            return;
        }

        var start = Clock.ToUtc(_date.Value + _start.Value);
        DateTimeOffset? end = null;
        if (!_stillOpen)
        {
            // Ende vor/gleich Beginn um 00:00 bedeutet Mitternacht am Folgetag.
            var endLocal = _date.Value + _end!.Value;
            if (_end.Value == TimeSpan.Zero)
                endLocal = endLocal.AddDays(1);
            end = Clock.ToUtc(endLocal);
        }

        _error = await Entries.SaveAsync(Entry?.Id ?? 0, _project.Id, _activity, start, end);
        if (_error is null)
            MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task Split()
    {
        var parameters = new DialogParameters<SplitDialog> { { d => d.Entry, Entry! } };
        var dialog = await Dialogs.ShowAsync<SplitDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
            MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task Merge(TimeEntry partner)
    {
        _error = await Entries.MergeAsync(Entry!.Id, partner.Id);
        if (_error is null)
            MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task Delete()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Eintrag löschen", "Diesen Eintrag wirklich löschen?",
            yesText: "Löschen", cancelText: "Abbrechen");
        if (confirmed != true)
            return;
        await Entries.DeleteAsync(Entry!.Id);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
