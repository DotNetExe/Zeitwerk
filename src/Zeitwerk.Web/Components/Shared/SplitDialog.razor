@* Abgeschlossenen Zeiteintrag an einem Rasterzeitpunkt in zwei Einträge teilen. *@
@inject EntryService Entries
@inject MasterDataService MasterData
@inject Clock Clock

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Eintrag teilen</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="zw-dialog-body">
            <MudText Class="zw-muted">
                @Entry.Project.DisplayName@(Entry.Activity is null ? "" : $" · {Entry.Activity}"),
                @Clock.ToLocal(Entry.Start).ToString("HH:mm") – @Clock.ToLocal(Entry.End!.Value).ToString("HH:mm")
            </MudText>
            <MudSelect T="DateTimeOffset" Label="Teilen um" @bind-Value="_at" Variant="Variant.Outlined" Margin="Margin.Dense"
                       ToStringFunc="@(t => Clock.ToLocal(t).ToString("HH:mm"))">
                @foreach (var point in _points)
                {
                    <MudSelectItem Value="point">@Clock.ToLocal(point).ToString("HH:mm")</MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.subtitle2">Zweiter Teil (@Clock.ToLocal(_at).ToString("HH:mm") – @Clock.ToLocal(Entry.End!.Value).ToString("HH:mm"))</MudText>
            <ProjectPicker Projects="_projects" @bind-Value="_project" Required="true" />
            <ActivityField ProjectId="_project?.Id" @bind-Value="_activity" />
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ContentCut"
                   OnClick="Split" Disabled="_project is null">Teilen</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Abgeschlossener Eintrag mit mindestens einem Teilungspunkt.</summary>
    [Parameter, EditorRequired] public TimeEntry Entry { get; set; } = null!;

    private List<Project> _projects = [];
    private List<DateTimeOffset> _points = [];
    private DateTimeOffset _at;
    private Project? _project;
    private string? _activity;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _points = SplitMergeRules.SplitPoints(Entry);
        _at = _points[(_points.Count - 1) / 2];

        _projects = await MasterData.GetActiveProjectsAsync();
        if (_projects.All(p => p.Id != Entry.ProjectId))
            _projects.Insert(0, Entry.Project);
        _project = _projects.First(p => p.Id == Entry.ProjectId);
        _activity = Entry.Activity;
    }

    private async Task Split()
    {
        _error = await Entries.SplitAsync(Entry.Id, _at, _project!.Id, _activity);
        if (_error is null)
            MudDialog.Close(DialogResult.Ok(true));
    }
}
